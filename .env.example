# Шаблон переменных для Coolify (Docker Compose).
# В Coolify: Resource → Environment Variables — скопировать ключи отсюда.
# Значения в git не коммитить. Файл `.env` на сервере генерирует Coolify.
#
# DATABASE_URL / REDIS_URL для стека из docker-compose.yml:
#   postgresql://anisync:PASSWORD@postgres:5432/anisync
#   redis://redis:6379

# --- Публичный URL (NEXT_PUBLIC_* — build-time в Coolify) ---
APP_BASE_URL=https://anisync.ru
NEXT_PUBLIC_BASE_URL=https://anisync.ru

# --- Postgres (сервис postgres в compose) ---
POSTGRES_USER=anisync
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=anisync
DATABASE_URL=postgresql://anisync:change-me-strong-password@postgres:5432/anisync

# --- Redis (сервис redis в compose) ---
REDIS_URL=redis://redis:6379
BULLMQ_PREFIX=anisync

# --- Безопасность ---
JWT_SECRET=replace-with-a-long-random-secret-min-16
CRON_SECRET=replace-with-a-long-random-secret-min-16
INTERNAL_SERVICE_SECRET=replace-with-a-long-random-secret-min-16

# --- Runtime ---
LOG_LEVEL=info
DEBUG=false
RUN_MIGRATIONS=true
SENTRY_DSN=

# --- Feature flags ---
RELEASES_MODULE_ENABLED=true
TORRENTS_MODULE_ENABLED=true
NEXT_PUBLIC_RELEASES_MODULE_ENABLED=true
NEXT_PUBLIC_TORRENTS_MODULE_ENABLED=true
REGISTRATION_OPEN=true
NEXT_PUBLIC_REGISTRATION_OPEN=true
MAINTENANCE_MODE=false

# --- Bootstrap admin (один раз) ---
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_EMAIL=admin@anisync.ru
# BOOTSTRAP_ADMIN_PASSWORD=

# --- Integrations ---
TMDB_API_KEY=
PROWLARR_URL=
PROWLARR_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

SHIKIMORI_BASE_URL=https://shikimori.one
SHIKIMORI_CLIENT_ID=
SHIKIMORI_CLIENT_SECRET=

MYANIMELIST_CLIENT_ID=
MYANIMELIST_CLIENT_SECRET=

ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=
