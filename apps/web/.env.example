# App Configuration
APP_BASE_URL=http://localhost:9002
NEXT_PUBLIC_BASE_URL=http://localhost:9002

# Database (local dev / docker-compose)
DATABASE_URL=postgresql://anisync:anisync@localhost:5432/anisync

# Redis / Queues (optional locally — without REDIS_URL uses HTTP self-dispatch)
REDIS_URL=redis://localhost:6379
BULLMQ_PREFIX=anisync

# Security
JWT_SECRET=replace-with-a-long-random-secret
CRON_SECRET=replace-with-a-long-random-secret
SENTRY_DSN=

# Observability
LOG_LEVEL=info
API_SLOW_REQUEST_MS=1500
DEBUG=false
DEBUG_MODULES=
DEBUG_SQL=false
DEBUG_EXTERNAL_API=false

# Feature flags (greenfield: modules on by default)
RELEASES_MODULE_ENABLED=true
TORRENTS_MODULE_ENABLED=true
NEXT_PUBLIC_RELEASES_MODULE_ENABLED=true
NEXT_PUBLIC_TORRENTS_MODULE_ENABLED=true
NEXT_PUBLIC_REGISTRATION_OPEN=true
REGISTRATION_OPEN=true
MAINTENANCE_MODE=false

# Bootstrap admin (only when users table empty)
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_EMAIL=admin@anisync.local
# BOOTSTRAP_ADMIN_PASSWORD=

# Optional legacy OnTrash import (Admin UI) — greenfield: leave off
# LEGACY_ONTRASH_IMPORT_ENABLED=true
# ONTRASH_DATABASE_URL=

# Internal AniSync routes only; no external torrent sidecar.
INTERNAL_SERVICE_SECRET=replace-with-a-long-random-secret

# TMDB (Releases module) — v4 Read Access Token (JWT) or v3 api_key
TMDB_API_KEY=
TMDB_UPCOMING_CACHE_TTL_MS=1800000
TMDB_SCHEDULE_CACHE_TTL_MS=3600000
RELEASES_WATCHLIST_STALE_MS=3600000
RELEASES_WATCHLIST_REFRESH_CONCURRENCY=4

# Prowlarr / Telegram (local TypeScript torrent watcher)
PROWLARR_URL=
# Optional public base for Telegram download links (when PROWLARR_URL is Docker-internal)
PROWLARR_PUBLIC_URL=
PROWLARR_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Provider Base URLs
SHIKIMORI_BASE_URL=https://shikimori.one

# OAuth Integrations
SHIKIMORI_CLIENT_ID=your_shikimori_client_id
SHIKIMORI_CLIENT_SECRET=your_shikimori_client_secret

MYANIMELIST_CLIENT_ID=your_mal_client_id
MYANIMELIST_CLIENT_SECRET=your_mal_client_secret

ANILIST_CLIENT_ID=your_anilist_client_id
ANILIST_CLIENT_SECRET=your_anilist_client_secret
