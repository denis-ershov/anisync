{
  "name": "anisync",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --filter @anisync/web dev",
    "build": "pnpm --filter @anisync/web build",
    "start": "pnpm --filter @anisync/web start",
    "lint": "pnpm --filter @anisync/web lint",
    "test": "pnpm --filter @anisync/web test",
    "typecheck": "pnpm --filter @anisync/web typecheck",
    "check": "pnpm --filter @anisync/web check",
    "db:generate": "pnpm --filter @anisync/web db:generate",
    "db:migrate": "pnpm --filter @anisync/web db:migrate",
    "db:push": "pnpm --filter @anisync/web db:push",
    "db:studio": "pnpm --filter @anisync/web db:studio",
    "worker": "pnpm --filter @anisync/web worker",
    "scheduler": "pnpm --filter @anisync/web scheduler",
    "admin:bootstrap": "pnpm --filter @anisync/web admin:bootstrap",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  }
}
